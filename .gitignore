# Rust
/target
**/*.rs.bk

# Runtime state — never committed. The repo holds the codebase, config and
# models; live account state is generated at runtime (see `the-quant restore`).
state/**
!state/.gitkeep

# Secrets
*.pem
*.key
.env
.env.*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Model artifacts are produced by the offline trainer (python/train)
models/*
!models/.gitkeep

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/